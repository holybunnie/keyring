[Unit]
Description=KEYRING read-only connection report
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/keyring
Environment=PYTHONPATH=/home/ubuntu/keyring/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/keyring/.venv/bin/python -m keyring dashboard --evidence /home/ubuntu/keyring/evidence/raw --state-file /home/ubuntu/keyring/state/dashboard.json --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ubuntu/keyring

[Install]
WantedBy=multi-user.target
